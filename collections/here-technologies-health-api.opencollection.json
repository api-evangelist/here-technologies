{
  "opencollection": "1.0.0",
  "info": {
    "name": "HERE Geocoding & Search API v7 Batch Jobs Health API",
    "version": "7.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "apiKey",
